# Copy this to amp.toml (gitignored — it holds credentials) and fill in
# your real values. Used by `cargo run -p server-deploy --bin deploy-amp`
# (also picked up automatically by deploy.sh if amp.toml exists).

[sftp]
host = "amp.example.com"
port = 2223
username = "steve"
password = "your-sftp-password"
# Optional: base32 TOTP secret if 2FA is enabled on this SFTP account (AMP
# appends the current 6-digit code to the password). Leave blank to disable.
# Must decode to at least 128 bits — a normal 20-byte authenticator-app
# secret is fine; very short test secrets will be rejected.
totp_secret = ""
# Absolute path on the AMP host to this instance's BepInEx/plugins folder.
remote_plugins_path = "/home/amp/.ampdata/instances/Valheim01/BepInEx/plugins"

[api]
base_url = "https://amp.example.com:8080"
username = "steve"
password = "your-amp-panel-password"
# Confirm this against <base_url>/API on your own instance (every AMP
# install self-documents its exact API there) — the method name/params can
# vary by AMP version and module. Default guess: Core/Restart.
restart_method = "Core/Restart"
